[MASTER]
load-plugins=pylint_django
django-settings-module=ngo_ccsh.settings
init-hook='import os; os.environ["DJANGO_SETTINGS_MODULE"] = "ngo_ccsh.settings"'
ignore=migrations,venv

[MESSAGES CONTROL]
disable=
    missing-module-docstring,
    missing-class-docstring,
    missing-function-docstring,
    too-few-public-methods,
    line-too-long,

[FORMAT]
max-line-length=120